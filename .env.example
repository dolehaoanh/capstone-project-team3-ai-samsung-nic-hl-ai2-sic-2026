APP_ENV=development
DATA_DIR=data
MODEL_PATH=models/baseline.joblib
ALLOW_ONLINE_REFRESH=false

# Read by the API (vietnam_stock_forecasting.api). There is no .env loader in the
# project, so export these in the shell; relative paths resolve against the repo root.
# SNAPSHOT_PATH overrides DATA_DIR and the bundled sample snapshot.
SNAPSHOT_PATH=
# Data older than this many days adds a notice to ForecastResponse.warnings.
SNAPSHOT_STALE_DAYS=7

# Background snapshot refresh (docs/CONTRACTS_VI.md section 4.5). Off unless
# ALLOW_ONLINE_REFRESH=true; needs the optional vnstock dependency. The refresh writes
# LIVE_SNAPSHOT_PATH (default <DATA_DIR>/raw/vn30_live.csv, ignored by git) and never
# rewrites the committed snapshot.
LIVE_SNAPSHOT_PATH=
REFRESH_HISTORY_DAYS=365
REFRESH_RETRY_MINUTES=30
